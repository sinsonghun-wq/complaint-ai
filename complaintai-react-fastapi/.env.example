PORT=8000
# Replace these placeholders in your local .env before starting the server.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@127.0.0.1:5433/complaintai
AUTH_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
WEB_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:8000
FILE_STORAGE_DIR=./data/uploads
MAX_BATCH_SIZE=500
CSV_MAX_UPLOAD_BYTES=1073741824
DOCUMENT_MAX_UPLOAD_BYTES=104857600
JOB_CONCURRENCY=1
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_MS=60000
LLM_IMPORT_ENABLED=true
LLM_IMPORT_CONCURRENCY=1
CSV_LLM_CONFIDENCE_THRESHOLD=0.5
CSV_RULE_OTHER_MIN_CONTENT_CHARS=80
IMPORT_PROGRESS_ROWS=10
IMPORT_HEARTBEAT_TIMEOUT_SECONDS=300
IMPORT_WORKER_POLL_SECONDS=2
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_API_URL=
EMBEDDING_TIMEOUT_MS=60000
PYTHON_PATH=
PDFTOPPM_PATH=

# AI 추천 답변 uses an independent 1024-dimensional index.
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_LLM_MODEL=qwen3.5:4b
RAG_RERANKER_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=600
RAG_CANDIDATES=6
RAG_CONTEXT_CHUNKS=4
RAG_MIN_RELEVANCE=0.35
RAG_NUM_CTX=8192
RAG_NUM_PREDICT=700

# 내 민원 검색의 유사 후보 검증 기준 (0~1). 공식 RAG 검색 기준과 별도입니다.
COMPLAINT_SEARCH_MIN_RELEVANCE=0.35
