PORT=8000
# Replace these placeholders in your local .env before starting the server.
DATABASE_URL=postgresql://postgres:0000@127.0.0.1:5433/complaintai
AUTH_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
WEB_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:5173,http://localhost:8000
FILE_STORAGE_DIR=./data/uploads
MAX_BATCH_SIZE=500
CSV_MAX_UPLOAD_BYTES=1073741824
DOCUMENT_MAX_UPLOAD_BYTES=104857600
JOB_CONCURRENCY=1
# LLM 백엔드: ollama(기존 방식) | llama_server(베이스 모델 + 어댑터, scripts/run_llama_server.ps1 로 먼저 실행)
LLM_BACKEND=llama_server
# [ollama] 모든 작업이 쓰는 모델. 파인튜닝 병합 모델이면 complaint-gemma4:latest
LLM_MODEL=qwen2.5:7b-instruct
# [ollama] CSV 열 매핑에만 다른 모델을 쓸 때 (비우면 LLM_MODEL). 예: gemma4:e4b
CSV_MAPPING_LLM_MODEL=
# [llama_server] 주소와 어댑터 설정
LLAMA_SERVER_URL=http://127.0.0.1:8080
# 어댑터를 켤 작업 (analysis=민원 분석, chat=챗봇, csv_mapping=CSV 열 매핑). 여기 없는 작업은 베이스 모델로 답합니다
LLM_ADAPTER_TASKS=analysis,chat
# llama-server 의 --lora 순번 (첫 번째 어댑터가 0)
LLAMA_SERVER_LORA_ID=0
# DB(llm_model)·API 응답에 남길 이름 (기록용)
LLAMA_SERVER_BASE_NAME=gemma4-e4b
LLAMA_SERVER_ADAPTER_NAME=complaint-lora-v1014_0014-f16
# LLM 컨텍스트 길이 (민원 분석·챗봇·CSV 매핑 공통). 로그의 prompt_tokens 를 보고 조정
# llama_server 는 이 값이 아니라 서버를 띄울 때의 슬롯당 컨텍스트(-c / -np)를 씁니다. 같은 값으로 맞춰 두세요
LLM_NUM_CTX=8192
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_MS=600000
LLM_IMPORT_ENABLED=true
LLM_IMPORT_CONCURRENCY=1
CSV_LLM_CONFIDENCE_THRESHOLD=0.5
CSV_RULE_OTHER_MIN_CONTENT_CHARS=80
IMPORT_PROGRESS_ROWS=10
IMPORT_HEARTBEAT_TIMEOUT_SECONDS=300
IMPORT_WORKER_POLL_SECONDS=2
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_API_URL=
EMBEDDING_TIMEOUT_MS=60000
PYTHON_PATH=
PDFTOPPM_PATH=
